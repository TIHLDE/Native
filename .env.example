# Copy to `.env.local` (gitignored). Plain `.env` is NOT gitignored.
# Without overrides the app talks to production Photon. See "Local Photon" in the
# README. Restart with `bun x expo start --clear` after changing this file.
# Leave a line commented out rather than empty: an empty value overrides the default.

# Base URL of Photon. Default: https://photon.tihlde.org
# EXPO_PUBLIC_PHOTON_URL=http://localhost:4000

# OAuth client id registered in Photon. Default: the app's public client
# (redirect tihlde://oauth/callback). Expo Go needs its own public client with
# redirect exp://<host>/--/oauth/callback, where <host> is the address Expo
# prints when the dev server starts.
# EXPO_PUBLIC_PHOTON_CLIENT_ID=<client id from Kvark>
