# ==============================================================================
# TIHLDE Native Environment Variables
# Copy this file to .env and uncomment what you need.
# Without overrides the app uses production Photon.
# Restart with `bun x expo start --clear` after changes.
# ==============================================================================

# --- Photon -------------------------------------------------------------------

# Base URL of Photon (default: https://photon.tihlde.org)
# EXPO_PUBLIC_PHOTON_URL=http://localhost:4000

# OAuth client id (default: the app's public client)
# EXPO_PUBLIC_PHOTON_CLIENT_ID=<client id from Kvark>