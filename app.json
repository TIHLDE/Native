{
  "expo": {
    "name": "TIHLDE",
    "slug": "Native",
    "version": "3.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tihlde",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tihlde.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.tihlde.app",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Inter.ttf"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "TIHLDE bruker kameraet til å skanne QR-koder ved innsjekk, og til å ta bilde av kvitteringer og bøter.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TIHLDE trenger tilgang til bildene dine for at du skal kunne legge ved en kvittering eller et bilde til en bot.",
          "cameraPermission": "TIHLDE bruker kameraet til å skanne QR-koder ved innsjekk, og til å ta bilde av kvitteringer og bøter.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#1c458a",
          "defaultChannel": "default"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "tihlde",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "849fbc28-9c38-440c-97b6-caa7525862cf"
      }
    }
  }
}
